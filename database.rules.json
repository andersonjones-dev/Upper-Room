{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('meta').exists()"
          }
        },
        "answers": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().parent().child('meta').exists()"
            }
          }
        }
      }
    }
  }
}
